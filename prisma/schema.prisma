// ============================================================================
// FOOD FACTORY POS - Prisma Schema
// Using Supabase PostgreSQL
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ============================================================================
// Models
// ============================================================================

model User {
  id          String   @id @default(uuid())
  name        String?
  email       String?  @unique
  phone       String?
  role        String   @default("customer")
  coinBalance Int      @default(0) @map("coin_balance")
  createdAt   DateTime @default(now()) @map("created_at")

  orders            Order[]
  profile           Profile?
  cart              Cart[]
  coinTransactions  CoinTransaction[]
  coinRedemptions   CoinRedemption[]

  @@map("users")
}

model Profile {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id")
  fullName      String?   @map("full_name")
  email         String?
  phone         String?
  gender        String?
  dob           DateTime? @db.Date
  houseNumber   String?   @map("house_number")
  street        String?
  area          String?
  city          String?
  state         String?
  postalCode    String?   @map("postal_code")
  country       String?   @default("India")
  latitude      Float?    @default(0)
  longitude     Float?    @default(0)
  fullAddress   String?   @map("full_address")
  avatarUrl     String?   @map("avatar_url")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  emoji     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String
  price       Float
  foodType    String   @default("veg") @map("food_type")
  isVeg       Boolean  @default(true) @map("is_veg")
  image       String?
  available   Boolean  @default(true)
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  reviews ProductReview[]

  @@index([category])
  @@index([available])
  @@map("products")
}

model ProductReview {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  userId    String   @map("user_id")
  userName  String   @default("Customer") @map("user_name")
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, userId])
  @@index([productId, createdAt(sort: Desc)])
  @@map("product_reviews")
}

model GoogleReview {
  id           String   @id @default(uuid())
  authorName   String   @map("author_name")
  rating       Int
  comment      String   @default("")
  relativeTime String   @default("") @map("relative_time")
  displayOrder Int      @default(0) @map("display_order")
  isVisible    Boolean  @default(true) @map("is_visible")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([displayOrder, createdAt(sort: Desc)])
  @@map("google_reviews")
}

model Customer {
  id              String    @id @default(uuid())
  name            String?
  phone           String    @unique
  email           String?
  totalOrders     Int       @default(0) @map("total_orders")
  totalSpent      Float     @default(0) @map("total_spent")
  loyaltyPoints   Int       @default(0) @map("loyalty_points")
  loyaltyDate     DateTime? @map("loyalty_date")
  lastOrderDate   DateTime? @map("last_order_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("customers")
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     Int         @unique @default(autoincrement()) @map("order_number")
  userId          String?     @map("user_id")
  customerName    String?     @map("customer_name")
  customerPhone   String?     @map("customer_phone")
  subtotal        Float
  discount        Float       @default(0)
  coinDiscount    Float       @default(0) @map("coin_discount")
  gst             Float       @default(0)
  grandTotal      Float       @map("grand_total")
  status          String      @default("pending")
  paymentMethod   String?     @map("payment_method")
  deliveryAddress Json?       @map("delivery_address")
  pendingAt       DateTime?   @map("pending_at")
  preparingAt     DateTime?   @map("preparing_at")
  readyAt         DateTime?   @map("ready_at")
  completedAt     DateTime?   @map("completed_at")
  cancelledAt     DateTime?   @map("cancelled_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  items           OrderItem[]
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String   @map("order_id")
  productName   String   @map("product_name")
  productPrice  Float    @map("product_price")
  quantity      Int
  total         Float
  createdAt     DateTime @default(now()) @map("created_at")

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Cart {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  productId String?  @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cart")
}

// ============================================================================
// Food Factory Coins — Loyalty / Rewards System
// ============================================================================

model CoinTransaction {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  type          String
  amount        Int
  balanceBefore Int      @map("balance_before")
  balanceAfter  Int      @map("balance_after")
  description   String
  referenceType String   @map("reference_type")
  referenceId   String?  @map("reference_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([referenceType, referenceId, type])
  @@index([userId, createdAt(sort: Desc)])
  @@index([referenceId])
  @@index([type])
  @@map("coin_transactions")
}

model CoinRedemption {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  coinsUsed      Int      @map("coins_used")
  discountAmount Float    @map("discount_amount")
  orderId        String?  @map("order_id")
  status         String   @default("PENDING")
  createdAt      DateTime @default(now()) @map("created_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("coin_redemptions")
}
