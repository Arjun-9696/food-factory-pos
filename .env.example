# ============================================================================
# FOOD FACTORY POS - Environment Variables Template
# ============================================================================
# Copy this to .env and fill in your values, then add them to Vercel
# Go to: Vercel Dashboard → Settings → Environment Variables
# ============================================================================

VITE_APPWRITE_PROJECT_ID=your_project_id_here
VITE_APPWRITE_PROJECT_NAME=Food Factory POS
VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
VITE_APPWRITE_STORAGE_NAME=product-images
VITE_APPWRITE_STORAGE_ID=product-images

# ============================================================================
# RAZORPAY PAYMENT GATEWAY (Standard Checkout)
# ============================================================================
# 1. Create/verify your Razorpay account & complete KYC (dashboard.razorpay.com)
# 2. Test keys: Dashboard → Settings → API Keys (generate Test keys first)
# 3. Live keys: generate later when going live (keep the account in test mode while developing)
#
# Public Key ID — safe to expose to the browser (opens the Razorpay Checkout).
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# Secret Key — SERVER ONLY. Never expose this to client-side JavaScript.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
# Webhook signing secret. MUST be identical to the one configured in the
# Razorpay Dashboard → Settings → Webhooks (recommended event version).
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================================================
# SUPABASE (auth + database). Used by the browser (public anon key) and by the
# server-side API handlers. The server reads public.users/public.profiles as
# the authenticated customer by forwarding their JWT — no service role key is
# required.
# ============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ============================================================================
# WHATSAPP INVOICE (optional — the invoice is delivered server-side after a
# successful payment; never faked).
# Leave WHATSAPP_PROVIDER empty to disable delivery (the record is then marked
# FAILED / not configured and payment success is not affected).
# ============================================================================
# The shop's WhatsApp business number (country code + number, digits only).
WHATSAPP_BUSINESS_PHONE=7406969321
# Provider: '' (disabled) | meta (WhatsApp Cloud API) | twilio
WHATSAPP_PROVIDER=

# Meta WhatsApp Cloud API:
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=food_factory_invoice

# Twilio WhatsApp:
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=

# ============================================================================
# DELIVERY ADDRESS + DELIVERY CHARGE
# ============================================================================
# A valid delivery address is REQUIRED before a payment can be started
# (no address → no order). The server is the source of truth for delivery:
# it measures the straight-line distance from the shop and charges:
#   FREE  within 2 km
#   ₹20   beyond 2 km
# An address without usable coordinates is treated as far (₹20). The free
# radius (2 km) and fee (₹20) are code constants in api/lib/amounts.ts and
# are mirrored client-side in src/lib/delivery.ts for display only.
# ============================================================================
# The shop's coordinates (used to compute the delivery distance). Override the
# Bangalore defaults if the shop is somewhere else.
FOOD_FACTORY_LATITUDE=12.8896366
FOOD_FACTORY_LONGITUDE=77.6010219

# ============================================================================
# GOOGLE MAPS REVIEWS (shown in Customer Reviews on product pages)
# ============================================================================
# 1. In Google Cloud Console (console.cloud.google.com), enable "Places API (New)"
# 2. Create an API key (APIs & Services > Credentials) and restrict it to
#    "Places API (New)" + your website's HTTP referrer
# 3. Find your shop's Place ID with Google's finder:
#    https://developers.google.com/maps/documentation/places/web-service/place-id#find-id
#    Search: "Food Factory - The Quality Taste" Bannerghatta Road Bangalore
# Leave either value empty and the Google section is simply hidden.
VITE_GOOGLE_PLACE_ID=
VITE_GOOGLE_PLACES_API_KEY=
